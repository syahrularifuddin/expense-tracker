# Production secrets for the expense stack. Copy to /opt/expense/.env on the VPS,
# fill every value, then `chmod 600 /opt/expense/.env`. Never commit the filled file.
#
#   scp deploy/.env.example <user>@<vps>:/opt/expense/.env

# Neon connection string. Use the direct endpoint (host WITHOUT "-pooler"): migrations
# take an advisory lock that is unreliable through the pooler. Keep sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# Signs the backend access JWTs. At least 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key that encrypts stored Gmail refresh tokens (32 bytes, base64).
# Generate: openssl rand -base64 32
# Changing it later makes every stored token unreadable: users must reconnect Google.
TOKEN_ENCRYPTION_KEY=

# Encrypts the Auth.js session cookie of the web app.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth web client, shared by the API (Gmail) and the web app (sign-in).
# Authorized redirect URI: https://expense.halosyahrul.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
