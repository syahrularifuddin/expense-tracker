DATABASE_URL=postgres://expense:expense@localhost:5432/expense
BIND_ADDR=127.0.0.1:8080
# Origin frontend yang diizinkan CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Penanda tangan access JWT, minimal 32 karakter. Buat: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# true = tanpa Google: email dibaca dari fixtures/emails.json dan
# POST /api/v1/auth/dev-login aktif. Tiga variabel di bawah boleh kosong.
MOCK_GMAIL=true

# Wajib jika MOCK_GMAIL bukan true.
# Kunci AES-256-GCM (32 byte, base64). Buat: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
