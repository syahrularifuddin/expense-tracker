# Salin ke .env.local

# Penanda tangan cookie sesi Auth.js. Buat: openssl rand -base64 32
AUTH_SECRET=

# Backend dilihat dari server Next.js (pertukaran token) dan dari browser.
BACKEND_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# true = tombol "Masuk sebagai user dev" (backend juga harus MOCK_GMAIL=true).
MOCK_GMAIL=true

# OAuth Client Google (tipe Web). Kosongkan untuk menyembunyikan login Google.
# Nilainya harus sama dengan GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET di backend.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
